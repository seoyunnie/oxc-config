{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@seoyunnie/oxc-config",
  "version": "1.3.0",
  "description": "Seoyun's shared base configurations for Oxlint and Oxfmt.",
  "keywords": [
    "oxc",
    "oxfmt",
    "oxfmt-config",
    "oxlint",
    "oxlint-config"
  ],
  "homepage": "https://github.com/seoyunnie/oxc-config#readme",
  "bugs": {
    "url": "https://github.com/seoyunnie/oxc-config/issues"
  },
  "license": "MIT",
  "author": "Seoyun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seoyunnie/oxc-config.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./oxfmt": "./src/oxfmt.ts",
    "./oxlint": "./src/oxlint/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      "./oxfmt": "./dist/oxfmt.js",
      "./oxlint": "./dist/oxlint.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "fmt": "oxfmt",
    "fmt:check": "pnpm run fmt --check",
    "lint": "oxlint",
    "lint:fix": "pnpm run lint --fix"
  },
  "devDependencies": {
    "@tsconfig/bases": "^1.0.24",
    "@types/node": "^24.12.4",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "oxlint-tsgolint": "^0.23.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "oxfmt": ">=0.52.0",
    "oxlint": ">=1.67.0",
    "oxlint-tsgolint": ">=0.23.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.3.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^24.11.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@11.3.0+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215"
}
